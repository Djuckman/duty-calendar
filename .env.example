# --- Общее ---
DUTY_TIMEZONE=Europe/Moscow
DUTY_PUBLIC_URL=http://duty.company.ru:8000
# DUTY_DATABASE_URL=sqlite:////data/duty.db
# DUTY_DATABASE_URL=postgresql+psycopg://duty:duty@db:5432/duty

# --- Первый администратор (создаётся, если пользователей ещё нет) ---
DUTY_ADMIN_USERNAME=admin
DUTY_ADMIN_PASSWORD=change-me-please
DUTY_SESSION_TTL_HOURS=12
DUTY_COOKIE_SECURE=false

# --- Фоновые задачи ---
DUTY_SCHEDULER_ENABLED=true
DUTY_PLAN_INTERVAL_MINUTES=30
DUTY_TICK_INTERVAL_MINUTES=5

# --- Производственный календарь: library (офлайн) | isdayoff (isdayoff.ru, с переносами) ---
DUTY_HOLIDAY_PROVIDER=library
DUTY_HOLIDAY_COUNTRY=RU

# --- Публикация смен во внешний календарь: none | log (exchange — будет) ---
DUTY_CALENDAR_PUBLISHER=none

# --- Mattermost: общий webhook, если у команды не задан свой ---
DUTY_MATTERMOST_DEFAULT_WEBHOOK=
DUTY_MATTERMOST_USERNAME=Дежурства
